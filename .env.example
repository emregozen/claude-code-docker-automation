# ============================================
# REQUIRED CONFIGURATION
# ============================================

# Anthropic API Key
# Get your API key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-xxxxx

# GitHub Personal Access Token
# Create at: https://github.com/settings/tokens
# Required scopes: repo, workflow
GITHUB_TOKEN=ghp_xxxxx

# Target Repository (format: owner/repository)
GITHUB_REPO=your-username/your-repo

# ============================================
# SOURCE CONFIGURATION
# ============================================

# Branch to clone and work from
SOURCE_BRANCH=main

# ============================================
# TASK CONFIGURATION
# ============================================

# The prompt for Claude Code
PROMPT=Fix all linting errors and add TypeScript types

# Alternative: Path to prompt file
# PROMPT_FILE=/prompt.txt

# ============================================
# GIT CONFIGURATION (Optional)
# ============================================

# Git commit author information
GIT_EMAIL=claude-bot@example.com
GIT_NAME=Claude Bot

# ============================================
# BRANCH & PR CONFIGURATION (Optional)
# ============================================

# Custom branch name (leave empty for auto-generated)
BRANCH_NAME=

# Base branch for pull request
BASE_BRANCH=

# Pull request title
PR_TITLE=

# Pull request body
PR_BODY=

# Commit message
COMMIT_MESSAGE=

# ============================================
# CLAUDE BOT REVIEW (Optional)
# ============================================

# Request review from Claude Bot after creating PR
REQUEST_CLAUDE_REVIEW=true

# ============================================
# ADVANCED OPTIONS (Optional)
# ============================================

# Save Claude Code execution logs
SAVE_LOGS=false
